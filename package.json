{
  "name": "nora",
  "version": "1.0",
  "description": "A simple boilerplate to get started with pywebview and React",
  "main": "index.js",
  "scripts": {
    "build": "npm run clean && npm run frontend:prod && run-script-os",
    "icons": "run-script-os",
    "icons:default": "bash scripts/generate-icons.sh",
    "icons:windows": "bash scripts/generate-icons.sh",
    "build:macos": "npm run icons && pyinstaller build-macos.spec",
    "build:windows": "npm run icons && pyinstaller build-windows.spec",
    "build:linux": "npm run icons && pyinstaller build-linux.spec",
    "build:appimage": "./build-appimage.sh",
    "build:linux:appimage": "npm run build:linux && npm run build:appimage",
    "clean": "run-script-os",
    "clean:default": "rm -rf dist 2>/dev/null; rm -rf gui 2>/dev/null; rm -rf build 2>/dev/null; ",
    "clean:windows": "if exist dist rd /S /Q dist & if exist build rd /S /Q build & if exist gui rd /S /Q gui",
    "dev": "vite ",
    "frontend:dev": "vite build --outDir gui --emptyOutDir",
    "frontend:prod": "vite build --outDir gui --emptyOutDir --minify",
    "frontend:preview": "vite preview --outDir gui --emptyOutDir",
    "init": "npm install && run-script-os",
    "init:windows": "virtualenv -p python venv && .\\venv\\Scripts\\pip install -r requirements.txt",
    "init:linux": "python3 -m venv venv-pywebview && ./venv-pywebview/bin/pip install --upgrade pip && sudo apt install -y libgirepository1.0-dev gcc libcairo2-dev pkg-config python3-dev gir1.2-gtk-3.0 gir1.2-webkit2-4.1 gir1.2-webkit2-4.0 && ./venv-pywebview/bin/pip install -r requirements.txt",
    "init:default": "python3 -m venv venv-pywebview && ./venv-pywebview/bin/pip install -r requirements.txt",
    "start": "npm run frontend:dev && run-script-os",
    "start:windows": ".\\venv\\Scripts\\python src\\index.py",
    "start:default": "./venv-pywebview/bin/python src/index.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r0x0r/pywebview-react-boilerplate.git"
  },
  "keywords": [
    "pywebview",
    "react",
    "python",
    "javascript"
  ],
  "author": "Roman Sirokov",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/r0x0r/pywebview-react-boilerplate/issues"
  },
  "homepage": "https://github.com/r0x0r/pywebview-react-boilerplate#readme",
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-datepicker": "^6.2.0",
    "framer-motion": "^11.2.6",
    "react": "^18.3.1",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "sort-by": "^0.0.2",
    "tanstack": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/recharts": "^1.8.29",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "postcss": "^8.4.33",
    "run-script-os": "^1.1.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.8",
    "vite-tsconfig-paths": "^4.2.1"
  }
}
